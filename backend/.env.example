# Copy to backend/.env and fill in real values. Do not commit .env.

# 访问令牌验签密钥，必须与 frontend/.env.local 的 AUTH_JWT_SECRET 完全一致，
# 否则登录后所有接口都会 401。生成方式: openssl rand -hex 32
AUTH_JWT_SECRET=

# 平台默认的对话模型与长文档精读模型。学校管理员可以在网页「AI 服务」页填学校自己的，
# 填了就优先用学校的；学生也能在那里填自带密钥，只对他本人生效。三处都没有时问答会提示「未配置」。
deepseek_API_key=your_deepseek_api_key
deepseek_url=https://api.deepseek.com/v1
deepseek_model=deepseek-chat

kimi_API_key=your_kimi_api_key
kimi_url=https://api.moonshot.cn/v1
kimi_model=kimi-k2-0905-preview

# 知识库向量化（智谱 embedding-3）的平台默认。学校管理员在「AI 服务」里填了自己的密钥就优先用学校的。
# 开源向量模型只预留了名字，不加载，也不打进镜像。
zhi_pu_API_KEY=your_zhipu_api_key

# 工具问答的平台默认 Key；学校在「AI 服务」页填了自己的就用学校的。留空则对应工具不开放
# 高德开放平台「Web 服务」类型的 Key：问路找地点、步行路线 https://console.amap.com/dev/key/app
AMAP_WEB_KEY=
# 博查 Web Search API Key：联网搜索 https://open.bochaai.com/
BOCHA_API_KEY=

# 不连任何模型、全部返回模拟数据，只给本地演示用；线上必须是 false
LLM_MOCK=false

xufei_APPID=your_xfyun_appid
xufei_APIKey=your_xfyun_api_key
xufei_APISecret=your_xfyun_api_secret

# 日志级别: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 上传体积上限（MB）
MAX_UPLOAD_MB=20

# 大模型调用超时（秒）与重试次数
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
KIMI_TIMEOUT_SECONDS=120

# 会话保留轮数，以及每次请求实际发给模型的轮数（后者用来压 token 成本）
MAX_STORED_TURNS=30
MAX_PROMPT_TURNS=10

# 每个用户在 CHAT_RATE_WINDOW_SECONDS 秒内最多提问 CHAT_RATE_LIMIT 次
CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW_SECONDS=60

# 工作区设置 / 嵌入挂件配置所在的 Postgres（只读）。compose 里已注入，本地单跑 API 时按需填写；
# 留空则一律使用默认设置，挂件访客无法通过校验
DATABASE_URL=postgresql://campus:<密码>@localhost:5433/smart_campus

# 情感分析时顺带抽取的个人事实是否自动写进长期记忆
MEMORY_AUTO_EXTRACT=true

# RAG 重排序：宽召回 candidate_k 个片段后，用 BGE 交叉编码器截断 Top-3
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-large
RERANK_CANDIDATE_K=50
