# Copy to backend/.env and fill in real values. Do not commit .env.

deepseek_API_key=your_deepseek_api_key
deepseek_url=https://api.deepseek.com

kimi_API_key=your_kimi_api_key
kimi_url=https://api.moonshot.cn/v1/chat/completions

zhi_pu_API_KEY=your_zhipu_api_key

xufei_APPID=your_xfyun_appid
xufei_APIKey=your_xfyun_api_key
xufei_APISecret=your_xfyun_api_secret

# RAG 重排序：宽召回 candidate_k 个片段后，用 BGE 交叉编码器截断 Top-3
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-large
RERANK_CANDIDATE_K=50
