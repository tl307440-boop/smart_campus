# Copy to backend/.env and fill in real values. Do not commit .env.

# 访问令牌验签密钥，必须与 frontend/.env.local 的 AUTH_JWT_SECRET 完全一致，
# 否则登录后所有接口都会 401。生成方式: openssl rand -hex 32
AUTH_JWT_SECRET=

deepseek_API_key=your_deepseek_api_key
deepseek_url=https://api.deepseek.com

kimi_API_key=your_kimi_api_key
kimi_url=https://api.moonshot.cn/v1/chat/completions

zhi_pu_API_KEY=your_zhipu_api_key

xufei_APPID=your_xfyun_appid
xufei_APIKey=your_xfyun_api_key
xufei_APISecret=your_xfyun_api_secret

# 日志级别: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 上传体积上限（MB）
MAX_UPLOAD_MB=20

# 大模型调用超时（秒）与重试次数
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
KIMI_TIMEOUT_SECONDS=120

# 会话保留轮数，以及每次请求实际发给模型的轮数（后者用来压 token 成本）
MAX_STORED_TURNS=30
MAX_PROMPT_TURNS=10

# 每个用户在 CHAT_RATE_WINDOW_SECONDS 秒内最多提问 CHAT_RATE_LIMIT 次
CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW_SECONDS=60

# RAG 重排序：宽召回 candidate_k 个片段后，用 BGE 交叉编码器截断 Top-3
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-large
RERANK_CANDIDATE_K=50
