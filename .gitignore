# Secrets — never commit
.env
.env.*
!.env.example
!**/.env.example
backend/.env
backend/.env.*
!backend/.env.example

# 部署产出的凭据（管理员密钥、SSH key、云厂商证书等）
deploy/**/.admin-key
deploy/**/*.key
deploy/**/*.pem
*.key
*.pem
!**/*.pub
# 学校站点缺的公开中间证书（见 backend/outbound.py），必须随代码部署
!backend/certs/*.pem

# Python
venv/
.venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / Next.js
node_modules/
frontend/.next/
frontend/out/
frontend/next-env.d.ts

# Prisma 生成的客户端（由 npm run db:generate 重建）
frontend/app/generated/

# Local runtime / vector DB
chroma_db_data/
backend/chroma_db_data/

# Generated / local media
*.mp3
*.wav

# Wiki PDF text extracts (rebuildable from data/)
wiki/_raw_extract/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Cursor local IDE state
.cursor/
