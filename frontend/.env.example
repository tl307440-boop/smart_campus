# 复制为 .env.local 后填写。不要提交 .env.local。

# FastAPI 服务地址；前端在浏览器侧直接访问，需与后端 FRONTEND_ORIGINS 对应
NEXT_PUBLIC_API_BASE=http://localhost:8001

# Postgres 连接串，供 Prisma 使用
DATABASE_URL=postgresql://user:password@localhost:5432/smart_campus

# 访问令牌签发密钥，必须与 backend/.env 的 AUTH_JWT_SECRET 完全一致。
# 生成方式: openssl rand -hex 32
AUTH_JWT_SECRET=
