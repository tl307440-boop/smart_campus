// 智悦校园 · 认证与租户数据模型
//
// 多租户设计：租户 = 学校。所有用户数据都挂在某个 Tenant 下，
// 学号只在同一学校内唯一（不同学校可以有相同学号）。
//
// 迁移命令（在 frontend/ 目录下执行）：
//   npx prisma migrate dev --name <描述>
//   npx prisma generate

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Prisma 7 起 url 不写在这里，改由 prisma.config.ts 提供
}

/// 租户：一所学校
model Tenant {
  id        String   @id @default(cuid())
  /// URL 友好的短标识，登录时用它区分学校，如 "wtli"
  slug      String   @unique
  name      String
  /// 关停后该校所有用户都无法登录，用于欠费/违规停用
  disabled  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@map("tenants")
}

enum UserRole {
  STUDENT
  STAFF
  ADMIN
}

/// 用户：某所学校下的一个人
model User {
  id       String @id @default(cuid())
  tenantId String

  /// 学号 / 工号，登录账号
  studentNo String
  name      String
  /// Argon2id 散列，永不存明文
  passwordHash String
  role         UserRole @default(STUDENT)
  disabled     Boolean  @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// 学号只在同一学校内唯一
  @@unique([tenantId, studentNo])
  @@index([tenantId])
  @@map("users")
}
