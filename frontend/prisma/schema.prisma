// 智悦校园 · 认证与租户数据模型
//
// 多租户设计：租户 = 学校。所有用户数据都挂在某个 Tenant 下，
// 学号只在同一学校内唯一（不同学校可以有相同学号）。
//
// 迁移命令（在 frontend/ 目录下执行）：
//   npx prisma migrate dev --name <描述>
//   npx prisma generate

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Prisma 7 起 url 不写在这里，改由 prisma.config.ts 提供
}

/// 租户：一所学校
model Tenant {
  id        String   @id @default(cuid())
  /// URL 友好的短标识，登录时用它区分学校，如 "wtli"
  slug      String   @unique
  name      String
  /// 关停后该校所有用户都无法登录，用于欠费/违规停用
  disabled  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  settings       TenantSettings?
  aiConfig       TenantAiConfig?
  embeds         EmbedConfig[]
  chatSessions   ChatSession[]
  chatTombstones ChatSessionTombstone[]
  questionLogs   QuestionLog[]
  feedbacks      MessageFeedback[]

  @@map("tenants")
}

/// 每所学校的工作区设置。FastAPI 只读（backend/workspace.py），表名与列名改动要同步那边的 SQL
model TenantSettings {
  tenantId            String   @id
  /// 助手称呼，同时出现在闲聊人设与嵌入挂件标题里
  assistantName       String   @default("小懒")
  /// 追加到系统提示词里的人设说明，空串表示用默认人设
  persona             String   @default("")
  /// 只按资料回答：检索不到内容时直接拒答，不走闲聊
  queryOnly           Boolean  @default(false)
  /// 余弦相似度下限（0-1），低于它的片段不进上下文；0 表示不过滤
  similarityThreshold Float    @default(0)
  /// 每次回答引用的片段数
  topK                Int      @default(3)
  /// 学校心理咨询的联系方式（电话、地点、时间），出现在求助卡片里；空串表示只给全国热线
  counselingContact   String   @default("")
  updatedAt           DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

/// 每所学校自配的 AI 服务。FastAPI 只读（backend/workspace.py 的 school_ai），表名与列名改动要同步那边的 SQL。
/// 密钥只存 AES-256-GCM 密文：lib/ai-config/secret-box.ts 加密，backend/secret_box.py 解密
model TenantAiConfig {
  tenantId      String   @id
  /// 对话模型：意图判定、闲聊、按资料回答、情绪分析共用。网址与模型 ID 空串表示用默认值
  chatBaseUrl   String   @default("")
  chatModel     String   @default("")
  /// 密文；空串表示没填，退回服务器 .env 的平台默认
  chatKey       String   @default("")
  /// 密钥末四位，给管理员认出是哪一把，不必解密
  chatKeyHint   String   @default("")
  /// 长文档精读：读整篇短文合集，摘出与问题相关的段落
  readerBaseUrl String   @default("")
  readerModel   String   @default("")
  readerKey     String   @default("")
  readerKeyHint String   @default("")
  /// 高德 Web 服务 Key：找校园地点、算步行路线。密文，空串退回服务器 .env 的 AMAP_WEB_KEY
  mapKey        String   @default("")
  mapKeyHint    String   @default("")
  /// 博查 Web Search API Key：联网搜索。密文，空串退回服务器 .env 的 BOCHA_API_KEY
  searchKey     String   @default("")
  searchKeyHint String   @default("")
  /// 教务对接：off 不接 / demo 演示数据 / zhengfang 正方教务（学生绑定自己的账号）
  jwMode        String   @default("off")
  /// 统一身份认证（CAS）根地址，如 https://cas.whwl.edu.cn:90/cas
  jwCasUrl      String   @default("")
  /// 正方教务根地址，如 https://jwxt.whwl.edu.cn:8088/jwglxt
  jwBaseUrl     String   @default("")
  /// 学校通知、新闻列表页，一行一个；Agent 回答「最新通知」时现查
  newsUrls      String   @default("")
  /// 知识库向量化。空串 / zhipu 用智谱 embedding-3；local / openai 只预留，后端不加载
  embeddingProvider String @default("")
  /// 预留的开源模型名。当前不会用来建索引
  embeddingModel    String @default("")
  /// 预留的兼容接口网址。当前不会发起请求
  embeddingBaseUrl  String @default("")
  /// 智谱 embedding-3 的密钥密文。学校管理员填的优先于服务器 .env
  embeddingKey      String @default("")
  embeddingKeyHint  String @default("")
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_ai_configs")
}

/// 可嵌入外部网站的聊天挂件。访客令牌由 Next 签发，FastAPI 按 id 回查启用状态与每日上限
model EmbedConfig {
  id             String   @id @default(cuid())
  tenantId       String
  name           String
  /// 允许调用的来源，形如 https://www.example.edu.cn；与浏览器 Origin 头逐字比对
  allowedOrigins String[]
  /// 整个挂件每天最多回答多少次，防止被刷爆账单
  dailyLimit     Int      @default(200)
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("embed_configs")
}

enum UserRole {
  STUDENT
  STAFF
  ADMIN
}

/// 用户：某所学校下的一个人
model User {
  id       String @id @default(cuid())
  tenantId String

  /// 学号 / 工号，登录账号
  studentNo String
  name      String
  /// Argon2id 散列，永不存明文
  passwordHash String
  role         UserRole @default(STUDENT)
  disabled     Boolean  @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  chatSessions   ChatSession[]
  chatTombstones ChatSessionTombstone[]
  feedbacks      MessageFeedback[]

  /// 学号只在同一学校内唯一
  @@unique([tenantId, studentNo])
  @@index([tenantId])
  @@map("users")
}

/// 一次对话。只由 FastAPI 读写（backend/chat_history.py 手写 SQL），表名与列名改动要同步那边。
/// 访客（嵌入挂件）的对话不进这张表，只在 Redis 里
model ChatSession {
  /// 等于前端的 thread_id（UUID）
  id            String   @id
  tenantId      String
  userId        String
  /// 第一条提问的前 40 个字
  title         String   @default("新的对话")
  /// 更早轮次的滚动摘要，组装提示词时注入；列表查询不读它
  summary       String   @default("")
  /// 摘要已覆盖到的最大 seq
  summarizedSeq Int      @default(0)
  createdAt     DateTime @default(now())
  /// 每成功一轮由 FastAPI 显式更新，列表按它倒序
  updatedAt     DateTime @default(now())

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([tenantId, userId, updatedAt(sort: Desc)])
  @@map("chat_sessions")
}

/// 会话里的一条消息。一轮成功 = 连续两条：用户 seq=2k-1，助手 seq=2k
model ChatMessage {
  id        String   @id
  sessionId String
  seq       Int
  /// user / assistant
  role      String
  content   String
  /// 助手回答时检索到的资料原文
  context   String   @default("")
  /// 来源卡片
  sources   Json     @default("[]")
  /// 工具查出的表格（空教室、成绩等），前端原样画出来
  tables    Json     @default("[]")
  emotion   Json?
  safety    Json?
  createdAt DateTime @default(now())

  session   ChatSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  feedbacks MessageFeedback[]

  @@unique([sessionId, seq])
  @@map("chat_messages")
}

/// 学生对一条助手回答的点赞 / 点踩。只由 FastAPI 读写（backend/usage_log.py），
/// 会话被删时跟着消息一起删
model MessageFeedback {
  id        String   @id
  tenantId  String
  userId    String
  messageId String
  /// 1 赞，-1 踩；取消评价就直接删这一行
  rating    Int
  /// 点踩时选的原因：wrong 答非所问 / outdated 信息过期 / verbose 太啰嗦 / other 其他；点赞和没选时为空
  reason    String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  /// 一个人对一条回答只有一个评价
  @@unique([messageId, userId])
  @@index([tenantId, rating, createdAt(sort: Desc)])
  @@map("message_feedbacks")
}

/// 一次提问的匿名记录，给管理员看哪些问题问得多、哪些没答上来。
/// 只由 FastAPI 读写（backend/usage_log.py）。不记是谁问的，只分登录用户和访客；
/// 情绪倾诉类的提问不存原文
model QuestionLog {
  id        String   @id
  tenantId  String
  /// 提问原文，最多 300 字；情绪倾诉（comfort）留空
  question  String
  /// answered 答上了 / refused 只按资料回答时拒答 / no_source 没检索到资料 / tool 工具问答 / comfort 情绪陪伴
  outcome   String
  /// 这一轮用过的工具名，逗号分隔
  tools     String   @default("")
  guest     Boolean  @default(false)
  /// 对应的助手消息，用来把点踩对回提问；访客和没入库的为空。不设外键：会话删了记录还在
  messageId String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("question_logs")
}

/// 删除标记：用户删过的会话。有它在，Redis 里残留的快照不会再被补回库里
model ChatSessionTombstone {
  tenantId  String
  userId    String
  threadId  String
  deletedAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tenantId, userId, threadId])
  @@map("chat_session_tombstones")
}
